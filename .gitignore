# ========================
# OS junk
# ========================
.DS_Store
Thumbs.db

# ========================
# Logs
# ========================
*.log
.nvimlog
/.lgai-costs.jsonl

# ========================
# Neovim
# ========================
# backup / swap / undo
*.swp
*.swo
*.bak
*.tmp
undo/
shada/
session/

# Lazy / plugin cache (DON’T commit)
config/nvim/.cache/
config/nvim/.local/
config/nvim/.luarc.json
config/nvim/.cursor/

# ========================
# TMUX
# ========================
# plugins should NOT be committed
config/tmux/plugins/

# ========================
# Python / UV / venvs
# ========================
.venv/
venv/
env/
__pycache__/
*.pyc

# uv specific
uv/
*.venv/

# ========================
# Node (if ever used)
# ========================
node_modules/

# ========================
# iTerm / macOS app data
# ========================
macos/iterm2/AppSupport
macos/iterm2/sockets/
config/lazygit/state.yml
raycast/ai/
cagent/

# Generated shell state
config/zsh/.zcompdump*
config/zsh/.zsh_sessions/

# ========================
# Backup configs (your case)
# ========================
nvim-backupl/

# ========================
# Misc
# ========================
bin/update-ds
*.lock
*.out
*.pid
config/zsh/tests/
