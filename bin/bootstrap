#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ "$(uname)" = Darwin ]]; then
  if ! command -v brew >/dev/null 2>&1; then
    echo "Homebrew is required before running bootstrap."
    echo "Install Homebrew first, then rerun ./bin/bootstrap."
    exit 1
  fi
  brew bundle --file "$ROOT_DIR/Brewfile"
else
  echo "Linux: skipping brew bundle (packages are installed via dnf/brew directly)."
fi

"$ROOT_DIR/bin/install.sh"

echo
echo "Bootstrap complete."
echo "Open Neovim once to install plugins."
