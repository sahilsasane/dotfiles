#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Everything under config/ and home/ is symlinked into place, so edits already
# land in this repo. Only copies made outside those links need syncing back.

if [ -f "$HOME/bin/tmxp" ]; then
  install -m 0755 "$HOME/bin/tmxp" "$ROOT_DIR/bin/tmxp"
fi

plutil -convert xml1 -o "$ROOT_DIR/macos/iterm2/com.googlecode.iterm2.plist" \
  "$HOME/Library/Preferences/com.googlecode.iterm2.plist"

echo "Sync complete. Review with: git status --short"
