<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.sahilsasane.rex-watch</string>
  <key>ProgramArguments</key><array>
    <string>__HOME__/Library/Application Support/com.superlogical.rex/RexServer/Versions/Current/Rex Server.app/Contents/MacOS/rex</string>
    <string>do</string><string>__HOME__/.config/rex/scripts/watch.lua</string><string>--all</string><string>--autostart=false</string>
  </array>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/><key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>__HOME__/.cache/rex-watch.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.cache/rex-watch.log</string>
</dict></plist>
