{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "session",
          "style": "diamond",
          "background": "#8839ef",
          "foreground": "#ffffff",
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": " {{ if .SSHSession }}\ueba9 {{ end }}{{ .UserName }}@{{ .HostName }} "
        },
        {
          "type": "os",
          "style": "plain",
          "foreground": "#4c4f69",
          "template": " {{ if .WSL }}WSL{{ else }}{{ .Icon }}{{ end }} "
        },
        {
          "type": "path",
          "style": "powerline",
          "background": "#df8e1d",
          "foreground": "#4c4f69",
          "powerline_symbol": "",
          "template": "  {{ .Path }} ",
          "properties": {
            "style": "folder"
          }
        },
        {
          "type": "git",
          "style": "powerline",
          "background": "#e6e9ef",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#f4dbd6{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#dce0e8{{ end }}",
            "{{ if gt .Ahead 0 }}#bcc0cc{{ end }}",
            "{{ if gt .Behind 0 }}#bcc0cc{{ end }}"
          ],
          "foreground": "#7287fd",
          "powerline_symbol": "",
          "template": " {{ .HEAD }}{{ if gt .Behind 0 }} <#df8e1d>⇣{{ .Behind }}</>{{ end }}{{ if gt .Ahead 0 }} <#fe640b>⇡{{ .Ahead }}</>{{ end }}{{ if gt .PushBehind 0 }} <#dd7878>⇠{{ .PushBehind }}</>{{ end }}{{ if gt .PushAhead 0 }} <#ea76cb>⇢{{ .PushAhead }}</>{{ end }}{{ if .UpstreamGone }} <#d20f39></>{{ end }}{{ if .Merge }} <#e64553></>{{ end }}{{ if .Rebase }} <#fe640b>{{ .Rebase.Current }}/{{ .Rebase.Total }}</>{{ end }}{{ if .CherryPick }} <#ea76cb></>{{ end }}{{ if .Revert }} <#dd7878>↶</>{{ end }}{{ if gt .StashCount 0 }} <#dc8a78>{{ .StashCount }}</>{{ end }}{{ if .Working.Changed }} <#d20f39> {{ .Working.String }}</>{{ end }}{{ if .Staging.Changed }} <#df8e1d> {{ .Staging.String }}</>{{ end }} ",
          "properties": {
            "branch_icon": "",
            "fetch_status": true,
            "fetch_push_status": true,
            "status_formats": {
              "Unmerged": "%d",
              "Added": "+%d",
              "Modified": "~%d",
              "Deleted": "-%d",
              "Untracked": "?%d"
            }
          }
        },
        {
          "type": "status",
          "style": "diamond",
          "background": "#40a02b",
          "background_templates": [
            "{{ if gt .Code 0 }}#d20f39{{ end }}"
          ],
          "foreground": "#ffffff",
          "options": {
            "always_enabled": true
          },
          "leading_diamond": "<transparent,background></>",
          "trailing_diamond": "",
          "template": " \ue23a {{ if gt .Code 0 }}\uf00d {{ reason .Code }}{{ else }}\uf42e{{ end }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "shell",
          "style": "powerline",
          "background": "#1e66f5",
          "foreground": "#ffffff",
          "powerline_symbol": "",
          "template": " \uf489 {{ .Name }} "
        },
        {
          "type": "battery",
          "style": "powerline",
          "background": "#f36943",
          "background_templates": [
            "{{if eq \"Charging\" .State.String}}#40c4ff{{end}}",
            "{{if eq \"Discharging\" .State.String}}#ff5722{{end}}",
            "{{if eq \"Full\" .State.String}}#4caf50{{end}}"
          ],
          "foreground": "#ffffff",
          "invert_powerline": true,
          "powerline_symbol": "",
          "options": {
            "charged_icon": "\ue22f ",
            "charging_icon": "\ueb2d ",
            "discharging_icon": "\uf244 "
          },
          "template": " {{ if not .Error }}{{ .Icon }}{{ .Percentage }}{{ end }}{{ .Error }}\uf295 "
        },
        {
          "type": "time",
          "style": "diamond",
          "background": "#179299",
          "foreground": "#111111",
          "invert_powerline": true,
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": " \ue641 {{ .CurrentDate | date .Format }} "
        },
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "#df8e1d",
          "template": " {{ .FormattedMs }} ",
          "properties": {
            "threshold": 1000,
            "style": "austin"
          }
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "#1e66f5",
          "template": " {{ .Venv }} ",
          "properties": {
            "display_mode": "environment",
            "fetch_version": false,
            "fetch_virtual_env": true,
            "display_default": false
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "kubectl",
          "style": "diamond",
          "background": "#df8e1d",
          "foreground": "#4c4f69",
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": " \uf308 Kubernetes {{.Context}} cluster {{if .Namespace}}- {{.Namespace}} namespace{{end}} "
        },
        {
          "type": "az",
          "style": "powerline",
          "background": "#9ec3f0",
          "foreground": "#4c4f69",
          "powerline_symbol": "",
          "template": " \uebd8 Subscription {{ .Name }} ({{ if .EnvironmentName | contains \"AzureCloud\" }}{{ \"Global\" }}{{ else }}{{ .EnvironmentName }}{{ end }}) "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#4c4f69",
          "template": "╰─❯ "
        }
      ]
    }
  ]
}
