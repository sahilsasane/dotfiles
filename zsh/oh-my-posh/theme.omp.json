{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "diamond",
          "background": "#cba6f7",
          "foreground": "#1e1e2e",
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": "{{ if .WSL }}WSL{{ else }}{{ .Icon }}{{ end }} "
          // "template": ">"
        },
        {
          "type": "path",
          "style": "powerline",
          "background": "#f9e2af",
          "foreground": "#1e1e2e",
          "powerline_symbol": "",
          "template": " {{ .Path }} ",
          "properties": {
            "style": "folder"
          }
        },
        {
          "type": "git",
          "style": "powerline",
          "background": "#45475a",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#6c3347{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#5c4e32{{ end }}",
            "{{ if gt .Ahead 0 }}#33466b{{ end }}",
            "{{ if gt .Behind 0 }}#33466b{{ end }}"
          ],
          "foreground": "#cba6f7",
          "powerline_symbol": "",
          "template": " <#b4befe></> <#b4befe><i>{{ .HEAD }}</i></>{{ if gt .Behind 0 }} <#f9e2af>⇣{{ .Behind }}</>{{ end }}{{ if gt .Ahead 0 }} <#fab387>⇡{{ .Ahead }}</>{{ end }}{{ if gt .PushBehind 0 }} <#f2cdcd>⇠{{ .PushBehind }}</>{{ end }}{{ if gt .PushAhead 0 }} <#f5c2e7>⇢{{ .PushAhead }}</>{{ end }}{{ if .UpstreamGone }} <#f38ba8></>{{ end }}{{ if .Merge }} <#eba0ac></>{{ end }}{{ if .Rebase }} <#fab387>{{ .Rebase.Current }}/{{ .Rebase.Total }}</>{{ end }}{{ if .CherryPick }} <#f5c2e7></>{{ end }}{{ if .Revert }} <#f2cdcd>↶</>{{ end }}{{ if gt .StashCount 0 }} <#f5e0dc>{{ .StashCount }}</>{{ end }}{{ if .Working.Changed }} <#f38ba8> {{ .Working.String }}</>{{ end }}{{ if .Staging.Changed }} <#f9e2af> {{ .Staging.String }}</>{{ end }} ",
          "properties": {
            "branch_icon": "",
            "fetch_status": true,
            "fetch_push_status": true,
            "status_formats": {
              "Unmerged": "%d",
              "Added": "+%d",
              "Modified": "~%d",
              "Deleted": "-%d",
              "Untracked": "?%d"
            }
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "shell",
          "style": "powerline",
          "background": "#89b4fa",
          "foreground": "#1e1e2e",
          "powerline_symbol": "",
          "template": " \uf489 {{ .Name }} "
        },
        {
          "type": "battery",
          "style": "powerline",
          "background": "#f36943",
          "background_templates": [
            "{{if eq \"Charging\" .State.String}}#40c4ff{{end}}",
            "{{if eq \"Discharging\" .State.String}}#ff5722{{end}}",
            "{{if eq \"Full\" .State.String}}#4caf50{{end}}"
          ],
          "foreground": "#ffffff",
          "invert_powerline": true,
          "powerline_symbol": "",
          "options": {
            "charged_icon": "\ue22f ",
            "charging_icon": "\ueb2d ",
            "discharging_icon": "\uf244 "
          },
          "template": " {{ if not .Error }}{{ .Icon }}{{ .Percentage }}{{ end }}{{ .Error }}\uf295 "
        },
        {
          "type": "time",
          "style": "diamond",
          "background": "#2e9599",
          "foreground": "#111111",
          "invert_powerline": true,
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": " \ue641 {{ .CurrentDate | date .Format }} "
        },
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "#f9e2af",
          "template": " {{ .FormattedMs }} ",
          "properties": {
            "threshold": 1000,
            "style": "austin"
          }
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "#89b4fa",
          "template": " {{ .Venv }} ",
          "properties": {
            "display_mode": "environment",
            "fetch_version": false,
            "fetch_virtual_env": true,
            "display_default": false
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#b1bad3",
          "template": "  "
        }
      ]
    }
  ]
}
