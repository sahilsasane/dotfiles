{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "separator": "",
    "showErrors": false
  },
  "modules": [
    {
      "type": "title",
      "format": "lua:layout = dofile((...).homeDir .. '/.config/fastfetch/layout.lua')"
    },
    {
      "type": "terminalsize",
      "format": "lua:terminalsizev = ..."
    },
    {
      "type": "os",
      "format": "lua:osv = ..."
    },
    {
      "type": "host",
      "format": "lua:hostv = ..."
    },
    {
      "type": "uptime",
      "format": "lua:uptimev = ..."
    },
    {
      "type": "packages",
      "format": "lua:packagesv = ..."
    },
    {
      "type": "cpu",
      "format": "lua:cpuv = ..."
    },
    {
      "type": "cpuusage",
      "format": "lua:cpuusagev = ..."
    },
    {
      "type": "gpu",
      "format": "lua:if not gpuv then gpuv = ... end"
    },
    {
      "type": "display",
      "format": "lua:local a = ...; if not displayv or a.isPrimary == true then displayv = a end"
    },
    {
      "type": "memory",
      "format": "lua:memoryv = ..."
    },
    {
      "type": "disk",
      "folders": "/",
      "format": "lua:diskv = ..."
    },
    {
      "type": "battery",
      "format": "lua:if not batteryv then batteryv = ... end"
    },
    {
      "type": "poweradapter",
      "format": "lua:if not adapterv then adapterv = ... end"
    },
    {
      "type": "processes",
      "format": "lua:processesv = ..."
    },
    {
      "type": "loadavg",
      "compact": false,
      "format": "lua:loadv = ..."
    },
    {
      "type": "shell",
      "format": "lua:shellv = ..."
    },
    {
      "type": "editor",
      "format": "lua:editorv = ..."
    },
    {
      "type": "terminal",
      "format": "lua:terminalv = ..."
    },
    {
      "type": "terminalfont",
      "format": "lua:fontv = ..."
    },
    {
      "type": "localip",
      "defaultRouteOnly": true,
      "showIpv6": false,
      "showMac": false,
      "format": "lua:local a = ...; if not ipv then ipv = a end"
    },
    {
      "type": "wifi",
      "format": "lua:local a = ...; if not wifiv or a.status == 'Connected' then wifiv = a end"
    },
    {
      "type": "custom",
      "format": "lua:return layout.render(terminalsizev and terminalsizev.columns, {os=osv, host=hostv, uptime=uptimev, packages=packagesv, cpu=cpuv, cpuusage=cpuusagev, gpu=gpuv, display=displayv, memory=memoryv, disk=diskv, battery=batteryv, adapter=adapterv, processes=processesv, load=loadv, shell=shellv, editor=editorv, terminal=terminalv, font=fontv, ip=ipv, wifi=wifiv})"
    }
  ]
}
